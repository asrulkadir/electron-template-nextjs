{
  "name": "electron-app-nextjs",
  "version": "0.1.0",
  "private": true,
  "main": "build/main.cjs",
  "author": "Synapsis",
  "description": "Electron app with Next.js SSR support",
  "scripts": {
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "postinstall": "electron-builder install-app-deps",
    "electron:build": "tsdown",
    "electron:build_watch": "tsdown --watch",
    "electron:watch": "cross-env NODE_ENV=development nodemon",
    "electron:dev": "npm-run-all --parallel electron:build_watch electron:watch",
    "electron:dist": "electron-builder --dir",
    "electron:dist:mac": "electron-builder --mac",
    "electron:dist:win": "electron-builder --win",
    "electron:dist:linux": "electron-builder --linux deb",
    "dev": "npm-run-all --parallel electron:dev next:dev",
    "build": "run-s next:build electron:build",
    "dist": "run-s next:build electron:build electron:dist"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "get-port-please": "^3.1.2",
    "next": "15.5.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "wait-port": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "tsdown": "^0.17.2",
    "typescript": "^5"
  },
  "build": {
    "asar": true,
    "executableName": "ElectronNextJS",
    "appId": "com.synapsis.electron-nextjs",
    "productName": "Electron NextJS",
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": ["**/*", "!**/node_modules"]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static"
      },
      {
        "from": "public",
        "to": "app/public"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development"
    }
  }
}
