{
  "$schema": "https://www.schemastore.org/electron-builder.json",
  "asar": true,
  "appId": "electron-nextjs",
  "productName": "electron-app-nextjs",
  "asarUnpack": ["**/*.node"],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icons/icon.png"
  },
  "linux": {
    "target": ["dir", "appimage", "zip"],
    "icon": "public/icons/icon.png"
  },
  "mac": {
    "target": ["dir", "dmg", "zip"],
    "icon": "public/icons/icon.icns"
  },
  "files": ["build/**/*", "package.json"],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "app",
      "filter": ["**/*", "!**/node_modules"]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "app/node_modules",
      "filter": ["**/*"]
    },
    {
      "from": ".next/static",
      "to": "app/.next/static"
    },
    {
      "from": "public",
      "to": "app/public"
    }
  ]
}
