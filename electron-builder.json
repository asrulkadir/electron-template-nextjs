{
  "$schema": "https://www.schemastore.org/electron-builder.json",
  "asar": true,
  "appId": "electron-nextjs",
  "productName": "Electron NextJS",
  "asarUnpack": ["**/*.node"],
  "win": {
    "target": ["dir", "portable", "zip"],
    "icon": "public/icons/icon.png"
  },
  "linux": {
    "target": ["dir", "appimage", "zip"],
    "icon": "public/icons/icon.png"
  },
  "mac": {
    "target": ["dir", "dmg", "zip"],
    "icon": "public/icons/icon.icns"
  },
  "files": ["build/**/*", "package.json"],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "app",
      "filter": ["**/*", "!**/node_modules"]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "app/node_modules",
      "filter": ["**/*"]
    },
    {
      "from": ".next/static",
      "to": "app/.next/static"
    },
    {
      "from": "public",
      "to": "app/public"
    }
  ]
}
